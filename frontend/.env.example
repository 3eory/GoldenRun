# Mapbox public token (starts with pk.)
VITE_MAPBOX_TOKEN=

# Supabase project URL and anon key (Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Soft client-side gate for /log page. Anyone who types this can post events.
# The real security is the RLS policy + RPC secret below.
VITE_LOG_PAGE_PASSWORD=changeme

# Shared secret the browser sends with every event insert; must match the
# OWNTRACKS_LOG_SECRET set in Supabase for the insert_event RPC.
VITE_LOG_RPC_SECRET=changeme

# Admin secret for destructive run controls (set start time, reset run).
# This must match app_config.key='admin_secret' in Supabase.
VITE_ADMIN_RPC_SECRET=changeme

# Optional: delay public live location by N minutes for safety (0 = live)
VITE_PUBLIC_DELAY_MINUTES=0

# Map style (any Mapbox style URL works)
# Dark: mapbox://styles/mapbox/dark-v11
# Light: mapbox://styles/mapbox/outdoors-v12
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/dark-v11

# Initial map center (fallback before any locations arrive)
VITE_MAP_INITIAL_LNG=-98.5795
VITE_MAP_INITIAL_LAT=39.8283
VITE_MAP_INITIAL_ZOOM=3.5
